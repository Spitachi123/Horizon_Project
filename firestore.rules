rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules,
// then click "Publish".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Looks up the caller's OWN profile doc to check their role.
    // Used so teachers can be granted broader read/write access
    // without students being able to fake a "teacher" role, since
    // the role on their own profile can never be changed after
    // creation (see the /users rule below).
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacher() {
      return signedIn() && myRole() == 'teacher';
    }

    // The caller's own subject (set at sign-up / editable later from
    // the teacher dashboard). Used to scope the anonymous Q&A inbox
    // and result entry so a Maths teacher can't read/answer a Physics
    // question, or enter/change a mark for a subject they don't teach.
    function mySubject() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subjectFocus;
    }
    // True only for a teacher whose own subjectFocus matches `subj`.
    function isTeacherOfSubject(subj) {
      return isTeacher() && mySubject() == subj;
    }

    // Each signed-in user may update only their OWN profile document
    // (users/{their-uid}), and may create it once at sign-up. The
    // "role" field can only be set at creation — not changed
    // afterwards, so a student can't quietly promote themselves to
    // teacher.
    //
    // READ is broader than just "your own doc": a teacher may read
    // every profile (class roster / ID cards / attendance / results),
    // and — this is the important part — ANY signed-in user, students
    // included, may read a profile whose `role` is 'student' or
    // 'teacher'. That's required for the class leaderboard to work at
    // all: AppData.listStudents()/listTeachers() run a collection
    // query filtered by `role`, and Firestore rejects the ENTIRE query
    // the instant it hits even a single matched document the rule
    // doesn't allow — not just that one row. With the old
    // self-or-teacher-only rule, a student loading the Milestones or
    // Overview tab would hit another student's/teacher's doc in that
    // query and the whole query (and everything chained after it in
    // the same Promise.all) would throw "Missing or insufficient
    // permissions", which is exactly what silently broke milestones,
    // points, and the leaderboard on the student dashboard. Since
    // names/points are already shown to the whole class on the
    // leaderboard by design, this isn't exposing anything the UI
    // doesn't already surface.
    match /users/{userId} {
      allow read: if signedIn() && (
                    request.auth.uid == userId
                    || isTeacher()
                    || resource.data.role == 'student'
                    || resource.data.role == 'teacher'
                  );
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role in ['student', 'teacher'];
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      // A teacher may remove any other account (student or teacher) —
      // used by the "Delete account" action on the ID Cards tab.
      // Nobody (not even a teacher) can delete their own profile this
      // way, so a teacher can never accidentally lock themselves out.
      allow delete: if isTeacher() && request.auth.uid != userId;
    }

    // Tiny counters used only to hand out sequential ID-card numbers
    // (STU-2026-0001, TCH-2026-0001, ...) at sign-up. No personal
    // data lives here — just a running number per role per year.
    match /counters/{counterId} {
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if false;
    }

    // Append-only sign-in history: every time any student or teacher
    // has entered the platform. Anyone signed in may write their own
    // entry (checked by uid match); only teachers can read the full
    // log (a student can still read entries with their own uid).
    match /loginLogs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isTeacher());
      allow update, delete: if false;
    }

    // Quizzes are authored by teachers, and readable by every signed
    // in user so students can find and take them.
    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.createdBy == request.auth.uid;
    }

    // A student may create their own attempt and read only their own
    // attempts. Teachers may read every attempt to grade/analyse.
    match /quizAttempts/{attemptId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow update: if false;
      // Only used by the account-deletion cascade, to clean up a
      // removed student's own attempt history.
      allow delete: if isTeacher();
    }

    // Attendance is written by teachers only. A student may read the
    // rows that belong to them; a teacher may read/update everything.
    match /attendance/{rowId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Holidays: any signed-in teacher may mark/unmark a date as a
    // school holiday. Every signed-in user can read the list, since
    // the "AI calculates working days" logic runs on both dashboards.
    match /holidays/{dateId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    // Reading materials & homework: teachers publish, everyone reads.
    // Any teacher may delete any material/homework (not just the one
    // who created it) so unwanted or outdated content can always be
    // cleaned up by whoever notices it.
    match /materials/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }
    match /homework/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    // Per-student checklist against a homework's AI-generated
    // day-by-day task plan. Doc id is deterministic
    // (`${homeworkId}__${studentId}`), so a student can only ever
    // read/write their own progress row; teachers can read every
    // row to see class-wide completion rates.
    match /homeworkProgress/{docId} {
      // IMPORTANT: a student's very first checklist tick for a given
      // homework has no document yet — `resource` is null on that
      // first read/write. Checking `resource.data.studentId` without
      // guarding for null first throws in the rules engine and gets
      // treated as "permission denied", which is exactly what broke
      // the homework checklist from ever loading. Always check
      // `resource == null` first so a not-yet-created doc reads as
      // "allowed" (there's nothing sensitive in "no progress yet").
      allow read: if signedIn() && (
                    resource == null ||
                    resource.data.studentId == request.auth.uid ||
                    isTeacher()
                  );
      allow create, update: if signedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && docId == request.resource.data.homeworkId + '__' + request.auth.uid;
      // Used only by the account-deletion cascade.
      allow delete: if isTeacher();
    }

    // Manually-entered results: any teacher may read the class's full
    // results (report-card style visibility), but only the teacher
    // whose own subject matches a result's `subject` may create it or
    // edit its marks — a Maths teacher cannot touch a Science result.
    // The owning student can always read only their own row (never
    // another student's), which is what keeps a result private to the
    // student it belongs to.
    // `delete` stays broad (any teacher) because it's also used by the
    // account-deletion cascade to clean up every result belonging to
    // a removed student, across every subject at once.
    match /results/{docId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create: if isTeacherOfSubject(request.resource.data.subject);
      allow update: if isTeacherOfSubject(resource.data.subject)
                    && request.resource.data.subject == resource.data.subject
                    && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isTeacher();
    }

    // Anonymous Q&A: a student creates a question tagged with their
    // own uid (needed so *they* can see their own answer later) and
    // their chosen subject, and can read only their own question.
    // A teacher may only read/answer a question whose subject matches
    // their own subjectFocus (or is tagged "General") — so a question
    // reaches the *respective subject teacher* only, never every
    // teacher in the school. The app's UI is responsible for never
    // displaying the student's name to a teacher, since the data
    // itself must still carry an owner for delivery/security.
    // Nobody may delete a question except a teacher cleaning up a
    // removed student's account (cascade — left broad, not
    // subject-scoped, so a leaving student's questions are always
    // fully removed regardless of which subjects they asked about).
    match /questions/{qId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // NOTE: the read rule must include an unconditional `isTeacher()`
      // branch (not ANDed with a subject check). Firestore rejects an
      // entire collection query up front unless it can prove every
      // possible match satisfies the rule using ONLY the query's own
      // filters — it does not filter results down document-by-document.
      // The account-deletion cascade queries `questions` filtered only
      // by `studentId` (it must remove a removed student's questions
      // across every subject, not just one teacher's own subject), so
      // a subject-scoped OR-branch here made that whole query get
      // rejected with "Missing or insufficient permissions" the moment
      // a deleted student had asked a question outside the deleting
      // teacher's own subject — which is exactly the error from the
      // "Delete" button on the ID Cards tab. Any signed-in teacher is
      // allowed to read here; the app's own UI still only ever *shows*
      // a teacher their own subject's inbox via listQuestionsForMySubject.
      allow read: if signedIn() && (
                    resource.data.studentId == request.auth.uid
                    || isTeacher()
                  );
      allow update: if (isTeacherOfSubject(resource.data.subject) || (isTeacher() && resource.data.subject == 'General'))
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.text == resource.data.text
                    && request.resource.data.subject == resource.data.subject;
      allow delete: if isTeacher();
    }

    // Milestones: any signed-in teacher may create one (the 3-per-day
    // cap is enforced client-side by counting today's docs before
    // creating — Firestore rules can't cheaply count documents, so
    // this is a soft limit rather than a hard security guarantee).
    // Every signed-in user (every student) can read the shared feed.
    // Any teacher may delete a milestone (moderation / cleanup — not
    // just the teacher who originally created it).
    match /milestones/{mId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isTeacher();
    }

    // Milestone completions award points. A student may only ever
    // create a completion for themselves (their own uid must match),
    // and the completion's document id is deterministic
    // (`${milestoneId}__${studentId}`), so a student physically
    // cannot create two completions for the same milestone — that's
    // what stops double-claiming points. Everyone signed in can read
    // the completions feed (needed for the leaderboard). Deleting is
    // otherwise blocked — only the account-deletion cascade (teacher)
    // may remove one, when cleaning up a removed student's history.
    match /milestoneCompletions/{cId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && cId == request.resource.data.milestoneId + '__' + request.auth.uid;
      allow update: if false;
      allow delete: if isTeacher();
    }

    // Unified points ledger: every points-earning action (milestone,
    // quiz, homework day) writes one entry here. A student may only
    // ever create an entry tagged with their own uid; each entry's id
    // is deterministic and source-specific (built by the app, e.g.
    // "quiz__<attemptId>" or "hw__<homeworkId>__<uid>__day<n>"), so the
    // same action can never pay out points twice. A student may delete
    // their own entry only to *undo* an action they can also undo
    // elsewhere (currently: unchecking a homework day) — never to
    // remove a milestone or quiz entry, which have no "undo" in the
    // app. Teachers may also delete entries, needed for the
    // account-deletion cascade.
    match /pointsLedger/{pId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && (
                      (resource.data.studentId == request.auth.uid && resource.data.source == 'homework')
                      || isTeacher()
                    );
    }
  }
}
